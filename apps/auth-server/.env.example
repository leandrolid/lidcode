# Vite uses port 3001; for Compose set this origin to http://localhost:3334.
AUTH_PUBLIC_ORIGIN=http://localhost:3001
AUTH_PORT=3334
AUTH_DATABASE_URL=postgresql://auth:replace-with-local-database-password@localhost:5434/auth
AUTH_DATABASE_SSL=false
AUTH_DATABASE_PORT=5434
AUTH_DATABASE_PASSWORD=replace-with-local-database-password
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Use a dedicated PostgreSQL instance/role with permission to create isolated test databases.
AUTH_TEST_DATABASE_URL=postgresql://auth:replace-with-local-database-password@localhost:5434/postgres

AUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
AUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
AUTH_GITHUB_CLIENT_ID=replace-with-github-client-id
AUTH_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
AUTH_RESEND_API_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=accounts@example.com
